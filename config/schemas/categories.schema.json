{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finops.local/schemas/categories.schema.json",
  "title": "FinOps Categories & Subcategories Configuration",
  "description": "Defines the 2-level taxonomy (category -> subcategory), default scope (shared/personal), annual flags, projection methods, alarm thresholds, and cost-cutting targets.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "categories"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "kind", "default_scope", "subcategories"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": ["income", "expense"]
          },
          "default_scope": {
            "type": "string",
            "enum": ["shared", "personal"]
          },
          "custom_split_weights": {
            "type": "object",
            "description": "Optional per-category override of shared split weights keyed by person_id.",
            "additionalProperties": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "subcategories": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "name", "projection_method"],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "is_annual": {
                  "type": "boolean",
                  "default": false
                },
                "default_scope": {
                  "type": "string",
                  "enum": ["shared", "personal"]
                },
                "projection_method": {
                  "type": "string",
                  "enum": [
                    "fixed_rule",
                    "annual_rule",
                    "moving_avg_3m",
                    "moving_avg_6m",
                    "budget_cap",
                    "none"
                  ]
                },
                "monthly_budget_cap": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Monthly budget cap / alarm threshold in currency units."
                },
                "warning_threshold_pct": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 100,
                  "default": 80,
                  "description": "Percentage of monthly_budget_cap that triggers a warning alarm (default 80%)."
                },
                "discretionary": {
                  "type": "boolean",
                  "default": false,
                  "description": "Marks a subcategory as discretionary / eligible for cost-cutting recommendations."
                },
                "cut_target_pct": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100,
                  "default": 20,
                  "description": "Target reduction percentage when computing cost-cutting opportunities."
                }
              }
            }
          }
        }
      }
    }
  }
}
