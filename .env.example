# =============================================================================
# FinOps Environment Configuration Template
# Copy to `.env` (gitignored) and populate with your own values.
# NEVER commit `.env` or real credentials to Git.
# =============================================================================

# --- PostgreSQL ---
POSTGRES_DB=finops
POSTGRES_USER=finops
POSTGRES_PASSWORD=change_me_local_dev_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://finops:change_me_local_dev_password@localhost:5432/finops

# --- Configuration Directory (IaC YAML files) ---
# Use `./config/examples` for demo/CI or `./local` for personal configs.
FINOPS_CONFIG_DIR=./local

# --- Application Ports ---
FINOPS_API_PORT=8080
FINOPS_WEB_PORT=5173
FINOPS_MCP_PORT=8090

# --- Pluggy API Credentials (Personal Use via Meu Pluggy -> Dashboard) ---
# See docs/meu-pluggy-setup.md for step-by-step instructions.
# Account 1 (Person A)
PLUGGY_PERSON_A_CLIENT_ID=replace_with_client_id_a
PLUGGY_PERSON_A_CLIENT_SECRET=replace_with_client_secret_a
# Optional: only required if you expose a public HTTPS endpoint for Pluggy webhooks
PLUGGY_PERSON_A_CLIENT_WEBHOOK_SIGN_SECRET=

# Account 2 (Person B)
PLUGGY_PERSON_B_CLIENT_ID=replace_with_client_id_b
PLUGGY_PERSON_B_CLIENT_SECRET=replace_with_client_secret_b
# Optional: only required if you expose a public HTTPS endpoint for Pluggy webhooks
PLUGGY_PERSON_B_CLIENT_WEBHOOK_SIGN_SECRET=

# --- Hermes Agent MCP Integration ---
# Generate a strong random token: `python3 -c "import secrets; print(secrets.token_urlsafe(32))"`
# Use the same token in `~/.hermes/.env` as `FINOPS_MCP_TOKEN`.
FINOPS_MCP_TOKEN=replace_with_strong_random_token
